"""Provably fair RNG и чистая математика игр (без I/O — легко тестировать).

Любой исход = HMAC-SHA256(server_seed, "client_seed:nonce:cursor").
server_seed — 256 бит из `secrets` (CSPRNG). Игроку заранее показывается только sha256(server_seed),
сам seed раскрывается при ротации — после этого любую ставку можно перепроверить.
"""
import hashlib
import hmac
import math
import secrets

GRID = 25


def new_server_seed() -> str:
    return secrets.token_hex(32)


def new_client_seed() -> str:
    return secrets.token_hex(6)


def sha256(s: str) -> str:
    return hashlib.sha256(s.encode()).hexdigest()


def floats(server_seed: str, client_seed: str, nonce: int, count: int) -> list[float]:
    """Равномерные числа из [0, 1): 4 байта на число, 8 чисел на один HMAC-блок."""
    out: list[float] = []
    cursor = 0
    while len(out) < count:
        d = hmac.new(server_seed.encode(), f"{client_seed}:{nonce}:{cursor}".encode(), hashlib.sha256).digest()
        out += [sum(b / 256 ** (j + 1) for j, b in enumerate(d[i:i + 4])) for i in range(0, 32, 4)]
        cursor += 1
    return out[:count]


def mine_positions(server_seed: str, client_seed: str, nonce: int, mines: int) -> list[int]:
    """Частичный Фишер–Йетс: любое подмножество из `mines` клеток равновероятно."""
    f, pool = floats(server_seed, client_seed, nonce, mines), list(range(GRID))
    return sorted(pool.pop(int(f[i] * len(pool))) for i in range(mines))


def mines_multiplier(mines: int, opened: int, rtp: float) -> float:
    """Честный коэффициент C(25,k)/C(25-m,k), умноженный на RTP. После первой клетки не ниже 1.01."""
    if opened == 0:
        return 1.0
    m = 1.0
    for i in range(opened):
        m *= (GRID - i) / (GRID - mines - i)
    return max(1.01, math.floor(m * rtp * 10000) / 10000)


def roll_percent(server_seed: str, client_seed: str, nonce: int) -> float:
    """Бросок 0.00–99.99 (10 000 равновероятных значений)."""
    return math.floor(floats(server_seed, client_seed, nonce, 1)[0] * 10000) / 100


def upgrader_chance(mult: float, rtp: float) -> float:
    """Шанс (%) для множителя; округляем вниз, чтобы фактический RTP не превышал заданный."""
    return math.floor(rtp / mult * 10000) / 100


def upgrader_mult(chance: float, rtp: float) -> float:
    return math.floor(rtp / chance * 10000) / 100


def crash_point(server_seed: str, client_seed: str, rtp: float, cap: float) -> float:
    """P(crash >= x) = rtp / x. Значения ниже 1.00 дают мгновенный краш (1.00x)."""
    h = hmac.new(server_seed.encode(), client_seed.encode(), hashlib.sha256).hexdigest()
    r = int(h[:13], 16) / 2 ** 52  # 52 бита -> [0, 1)
    return min(cap, max(1.0, math.floor(rtp / (1 - r) * 100) / 100))


def crash_time_ms(point: float, growth: float) -> float:
    """Через сколько мс множитель m(t) = e^(growth·t) достигнет point."""
    return math.log(point) / growth


def crash_mult_h(elapsed_ms: float, growth: float) -> int:
    """Текущий множитель в сотых долях (250 = 2.50x), округление вниз."""
    return math.floor(math.exp(growth * elapsed_ms) * 100)
AURUM_EOF

cat > backend/app/core.py <<'AURUM_EOF'
"""Ошибки, проверка Telegram initData, пользователи и антифрод."""
import hashlib
import hmac
import json
import time
from urllib.parse import parse_qsl

from fastapi import Depends, Request
from loguru import logger
from redis.exceptions import RedisError
from sqlalchemy.dialects.postgresql import insert
from sqlalchemy.ext.asyncio import AsyncSession

from .config import settings
from .db import get_session, redis
from .fair import new_client_seed, new_server_seed
from .models import Transaction, User


class GameError(Exception):
    """Ожидаемая ошибка: уходит клиенту как {"error": {"code", "message"}}."""

    def __init__(self, code: str, message: str = "", status: int = 400):
        super().__init__(message or code)
        self.code, self.message, self.status = code, message or code, status


def parse_init_data(raw: str) -> dict:
    """Проверяем подпись initData (HMAC-SHA256 от токена бота) и свежесть auth_date."""
    try:
        data = dict(parse_qsl(raw, keep_blank_values=True, strict_parsing=True))
        got = data.pop("hash")
        user = json.loads(data["user"])
    except (ValueError, KeyError):
        raise GameError("invalid_auth", "Bad initData", 401)
    check = "\n".join(f"{k}={v}" for k, v in sorted(data.items()))
    secret = hmac.new(b"WebAppData", settings.bot_token.encode(), hashlib.sha256).digest()
    if not hmac.compare_digest(hmac.new(secret, check.encode(), hashlib.sha256).hexdigest(), got):
        raise GameError("invalid_auth", "Bad signature", 401)
    if time.time() - int(data.get("auth_date", 0)) > settings.initdata_ttl:
        raise GameError("auth_expired", "Session expired, reopen the app", 401)
    return {"user": user, "start_param": data.get("start_param")}


async def get_or_create_user(s: AsyncSession, tg: dict, ref: int | None = None) -> tuple[User, bool]:
    """Находит игрока или создаёт со стартовым балансом. Безопасно при параллельных первых запросах."""
    uid = int(tg["id"])
    name, uname, photo = tg.get("first_name", ""), tg.get("username"), tg.get("photo_url")
    user = await s.get(User, uid)
    if user:
        if (user.first_name, user.username, user.photo_url) != (name, uname, photo):
            user.first_name, user.username, user.photo_url = name, uname, photo
            await s.commit()
        return user, False
    ref_id = ref if ref and ref != uid and await s.get(User, ref) else None
    lang = "ru" if (tg.get("language_code") or "en")[:2] in ("ru", "uk", "be", "kk") else "en"
    start = settings.minor(settings.start_balance)
    res = await s.execute(insert(User).values(
        id=uid, username=uname, first_name=name, photo_url=photo, lang=lang, balance=start, referrer_id=ref_id,
        server_seed=new_server_seed(), client_seed=new_client_seed(),
    ).on_conflict_do_nothing(index_elements=["id"]))
    created = res.rowcount == 1
    if created:
        s.add(Transaction(user_id=uid, kind="start", amount=start, balance_after=start))
    await s.commit()
    return await s.get(User, uid), created


async def guard(uid: int) -> None:
    """Антифрод: общий лимит запросов и автоблок на 10 минут при систематическом превышении."""
    try:
        if await redis.exists(f"blk:{uid}"):
            raise GameError("rate_limited", "Temporarily blocked", 429)
        n = await redis.incr(f"rl:{uid}")
        if n == 1:
            await redis.expire(f"rl:{uid}", 10)
        if n > 60:  # >60 запросов за 10 секунд — не человек
            if await redis.incr(f"viol:{uid}") > 20:
                await redis.set(f"blk:{uid}", 1, ex=600)
            await redis.expire(f"viol:{uid}", 600)
            raise GameError("rate_limited", "Too many requests", 429)
    except RedisError as e:  # Redis недоступен — не роняем игру
        logger.warning(f"redis: {e}")


async def cooldown(uid: int, action: str, ms: int) -> None:
    """Кулдаун между однотипными действиями (старт игры, клик по клетке, спин)."""
    try:
        ok = await redis.set(f"cd:{uid}:{action}", 1, nx=True, px=ms)
    except RedisError:
        return
    if not ok:
        raise GameError("too_fast", "Too fast", 429)


async def authenticate(raw: str, s: AsyncSession) -> User:
    """raw = "tma <initData>" (Telegram) или "dev <id>" (только при DEV_AUTH=true)."""
    scheme, _, payload = raw.partition(" ")
    if scheme == "dev" and settings.dev_auth and payload.isdigit():
        tg, start = {"id": int(payload), "first_name": f"Dev{payload}", "language_code": "en"}, None
    elif scheme == "tma" and payload:
        d = parse_init_data(payload)
        tg, start = d["user"], d["start_param"]
    else:
        raise GameError("invalid_auth", "Open the app from Telegram", 401)
    ref = int(start[4:]) if start and start.startswith("ref_") and start[4:].isdigit() else None
    user, _ = await get_or_create_user(s, tg, ref)
    if user.banned:
        raise GameError("banned", "Account is banned", 403)
    await guard(user.id)
    return user


async def current_user(request: Request, s: AsyncSession = Depends(get_session)) -> User:
    return await